[Unit]
Description=Tool host: every session's MCP tools, over streamable HTTP behind its token
# docs/mcp-host.md.

[Service]
WorkingDirectory=%h/.local/share/bmo-pocket/deploy
# The host's own settings, BMO_MCP_HOST_PORT and BMO_MCP_HOST_CONSOLE_PORT among them, where the deployment's env
# file names them (docs/api.md, 「The variables」). The issuer token stands in tool-host/issuer-token under the data
# root, made at the first start, and the console token in tool-host/console-token, made at the first start that
# opens the console face.
EnvironmentFile=-%h/.local/share/bmo/data/env/pocket.env
# What a placed tool's call runs reaches the programs it starts by this path.
Environment=PATH=%h/.local/bin:%h/.bun/bin:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# The placed tools are named through the deploy tree's link, which the host follows onto each release it is
# flipped to; the binary's own path is the real one of the release it started in.
ExecStart=%h/.local/share/bmo-pocket/deploy/bin/mcp-host serve --data-root %h/.local/share/bmo/data --tools %h/.local/share/bmo-pocket/deploy/tools
Restart=always
RestartSec=2
# A stop reaches the host alone and waits for it to end: on SIGTERM it takes no new call, lets every call in hand
# run to its end and exits, so neither a signal nor a span of systemd's ends a call (docs/mcp-host.md, 「The host's
# stop」). What is left in the unit once it has exited is killed.
KillMode=mixed
TimeoutStopSec=infinity

[Install]
WantedBy=default.target
# The repository's one service, linked and restarted by every deployment, whose health the deployment waits on.
X-BMO-Deploy=bot
