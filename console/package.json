{
  "name": "bmo-pocket-console",
  "version": "0.0.0",
  "description": "The tool host's screen, built as the browser module a console loads by the host's manifest.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "nuxi prepare",
    "bundle": "nuxi prepare && vite build --config bundle/vite.config.ts",
    "typecheck": "nuxi prepare && vue-tsc --noEmit -p .nuxt/tsconfig.app.json && tsc -p bundle/tsconfig.json",
    "check": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@nuxt/ui": "4.12.2",
    "vue": "^3.5.24",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@bmo/pocket-client": "file:../client",
    "@nuxtjs/i18n": "^10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.3.4",
    "@vitejs/plugin-vue": "6.0.10",
    "bmo-ui": "file:vendor/bmo-ui-1.1.0-0.nightly.20261128.3.tgz",
    "nuxt": "^4.5.2",
    "playwright-core": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.4",
    "vue-i18n": "^11.4.8",
    "vue-tsc": "^3.2.0"
  },
  "patchedDependencies": {
    "@nuxt/icon@2.5.1": "patches/@nuxt%2Ficon@2.5.1.patch",
    "reka-ui@2.11.0": "patches/reka-ui@2.11.0.patch",
    "@nuxt/ui@4.12.2": "patches/@nuxt%2Fui@4.12.2.patch"
  }
}
